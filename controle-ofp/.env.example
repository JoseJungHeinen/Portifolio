APP_NAME="Exemplo OFP"
APP_URL=http://localhost:8091
APP_DEBUG=false

DB_HOST=db.exemplo.local
DB_PORT=3306
DB_DATABASE=exemplo_db
DB_USERNAME=app_user
DB_PASSWORD=

SESSION_NAME=ofp_sess
BCRYPT_COST=12

# Dias após a NF de devolução para o crédito cair (coluna PRAZO da planilha v4)
PRAZO_CREDITO_DIAS=90

# Dias para a Fabricante analisar uma OFP depois da abertura no CSPS (alerta de cobrança)
SLA_ANALISE_DIAS=10

# OFP ativa sem nenhum evento há mais de N dias entra no alerta diário como "parada"
DIAS_PARADA=15

# log = grava em storage/logs/emails.log ; smtp = envia de verdade
MAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURITY=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Exemplo OFP"
