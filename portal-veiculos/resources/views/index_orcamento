$mysqli = new mysqli('localhost', 'app_user', 'TROQUE_NO_SERVIDOR', 'Veiculos');
if ($mysqli->connect_errno) {
    die('Falha na conexão: (' . $mysqli->connect_errno . ') ' . $mysqli->connect_error);
